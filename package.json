{
  "name": "purrable",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "bench",
      "packages/*",
      "tools"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/stage.ts dev",
    "build": "turbo run build",
    "deploy:dev": "bun scripts/stage.ts deploy:dev",
    "plan:dev": "bun scripts/stage.ts plan:dev",
    "destroy:dev": "bun scripts/stage.ts destroy:dev",
    "smoke:dev": "bun --env-file .local/dev.env scripts/smoke-dev.ts",
    "smoke:local": "PURRABLE_STAGE=local PURRABLE_APP_URL=http://localhost:18971 bun --env-file .local/local.env scripts/smoke-dev.ts",
    "icons": "bun scripts/app-icons.ts",
    "fmt": "oxfmt -c oxfmt.config.ts --write",
    "fmt:check": "oxfmt -c oxfmt.config.ts --check",
    "lint": "oxlint -c oxlint.config.ts .",
    "lint:fix": "oxlint -c oxlint.config.ts --fix .",
    "lint:gate": "bun tools/lint-gate.ts",
    "lint:report": "bun tools/lint-report.ts",
    "effect:check": "bun tools/effect-check.ts --workspaces tsconfig.json",
    "knip": "knip --no-progress",
    "dupes": "jscpd",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "agents:check": "bun tools/docs-public.ts",
    "bench:plan": "bun bench/scripts/cli.ts plan",
    "bench:validate": "bun bench/scripts/cli.ts validate",
    "check:files": "bun tools/check-files.ts",
    "graph": "bun tools/check-graph.ts",
    "check:fast": "bun run fmt:check && bun run agents:check && bun run lint && bun run typecheck && bun run test:unit",
    "check": "bun run fmt:check && bun run agents:check && bun run graph && bun run typecheck && bun run lint:gate && bun run dupes && bun run test && bun run test:integration && bun run build",
    "infra": "alchemy",
    "check:public": "bun run fmt:check && bun run agents:check && bun run graph && bun run typecheck && bun run lint:gate && bun run dupes && bun run test && bun run test:integration && bun run build"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.0",
    "@types/bun": "1.4.2",
    "@types/node": "22.18.0",
    "alchemy": "2.0.0-beta.80",
    "effect": "4.0.0",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-plugin-complexity": "2.1.8",
    "oxlint-tsgolint": "7.0.2003",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@better-auth/oauth-provider": "1.7.6",
    "@effect/platform-node-shared": "4.0.0"
  },
  "packageManager": "bun@1.4.2",
  "license": "MIT"
}
