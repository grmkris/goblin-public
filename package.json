{
  "name": "goblin",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "bench",
      "packages/*",
      "tools"
    ]
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/stage.ts dev",
    "build": "turbo run build",
    "deploy:dev": "bun scripts/stage.ts deploy:dev",
    "plan:dev": "bun scripts/stage.ts plan:dev",
    "destroy:dev": "bun scripts/stage.ts destroy:dev",
    "dev:wallet": "bun scripts/wallet-stage.ts dev",
    "plan:wallet-dev": "bun scripts/wallet-stage.ts plan:dev",
    "deploy:wallet-dev": "bun scripts/wallet-stage.ts deploy:dev",
    "plan:wallet-prod": "bun scripts/wallet-stage.ts plan:prod",
    "deploy:wallet-prod": "bun scripts/wallet-stage.ts deploy:prod",
    "smoke:dev": "bun --env-file .local/dev.env scripts/smoke-dev.ts",
    "ui:acceptance": "bun scripts/ui-acceptance.ts",
    "smoke:local": "GOBLIN_STAGE=local GOBLIN_APP_URL=http://localhost:18971 bun --env-file .local/local.env scripts/smoke-dev.ts",
    "icons": "bun scripts/app-icons.ts",
    "fmt": "oxfmt -c oxfmt.config.ts --write",
    "fmt:check": "oxfmt -c oxfmt.config.ts --check",
    "lint": "oxlint -c oxlint.config.ts .",
    "lint:gate": "bun tools/lint-gate.ts",
    "lint:report": "bun tools/lint-report.ts",
    "effect:check": "bun tools/effect-check.ts --workspaces tsconfig.json",
    "knip": "knip --no-progress",
    "dupes": "jscpd",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:integration:permuted": "turbo run test:integration:permuted",
    "agents:check": "bun tools/docs-public.ts",
    "bench:recall": "bun bench/scripts/cli.ts recall",
    "bench:campaign-plan": "bun bench/scripts/cli.ts campaign-plan",
    "bench:campaign-run": "bun bench/scripts/cli.ts campaign-run",
    "bench:campaign-resume": "bun bench/scripts/cli.ts campaign-resume",
    "bench:campaign-report": "bun bench/scripts/cli.ts campaign-report",
    "bench:review-packet": "bun bench/scripts/cli.ts review-packet",
    "bench:review-votes": "bun bench/scripts/cli.ts review-votes",
    "bench:canary": "bun bench/scripts/cli.ts canary",
    "bench:import": "bun bench/scripts/cli.ts import",
    "bench:review": "bun bench/scripts/cli.ts review",
    "bench:plan": "bun bench/scripts/cli.ts plan",
    "bench:validate": "bun bench/scripts/cli.ts validate",
    "bench:run": "bun bench/scripts/cli.ts run",
    "bench:resume": "bun bench/scripts/cli.ts resume",
    "bench:report": "bun bench/scripts/cli.ts report",
    "bench:compare": "bun bench/scripts/cli.ts compare",
    "bench:promote": "bun bench/scripts/cli.ts promote",
    "bench:doctor": "bun bench/scripts/cli.ts doctor",
    "check:files": "bun tools/check-files.ts",
    "check:patches": "bun tools/check-patches.ts",
    "goblin": "bun apps/cli/src/main.ts",
    "graph": "bun tools/check-graph.ts",
    "check:fast": "bun run fmt:check && bun run agents:check && bun run check:patches && bun run check:chat-ids && bun run lint && bun run typecheck && bun run test:unit",
    "check": "bun run fmt:check && bun run agents:check && bun run check:patches && bun run check:chat-ids && bun run graph && bun run typecheck && bun run check:spikes && bun run lint:gate && bun run dupes && bun run test && bun run test:integration && bun run test:integration:permuted && bun run build",
    "deploy:prod": "bun scripts/stage.ts deploy:prod",
    "plan:prod": "bun scripts/stage.ts plan:prod",
    "destroy:prod": "bun scripts/stage.ts destroy:prod",
    "smoke:prod": "bun scripts/stage.ts smoke:prod",
    "drift:dev": "bun scripts/stage.ts drift:dev",
    "drift:prod": "bun scripts/stage.ts drift:prod",
    "bench:decisions": "bun bench/scripts/decisions.ts",
    "check:chat-ids": "bun tools/check-chat-ids.ts",
    "check:spikes": "bun run --cwd spikes/coding typecheck && bun run --cwd spikes/coding test --path-ignore-patterns=test/verifier.test.ts && bun run --cwd spikes/coding-cf typecheck",
    "check:public": "bun run fmt:check && bun run agents:check && bun run check:patches && bun run check:chat-ids && bun run graph && bun run typecheck && bun run check:spikes && bun run lint:gate && bun run dupes && bun run test && bun run test:integration && bun run test:integration:permuted && bun run build"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.0",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/bun": "1.4.2",
    "@types/node": "22.18.0",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.1",
    "jscpd": "5.4.0",
    "knip": "6.39.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-plugin-complexity": "2.1.8",
    "oxlint-tsgolint": "7.0.2003",
    "playwright-core": "1.63.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@better-auth/oauth-provider": "1.7.6",
    "@effect/platform-bun": "4.0.1",
    "@effect/platform-node": "4.0.1",
    "@effect/platform-node-shared": "4.0.1",
    "@effect/sql-d1": "4.0.1",
    "@effect/sql-sqlite-do": "4.0.1",
    "@effect/vitest": "4.0.1",
    "@hono/node-server": "1.19.17",
    "hono": "4.13.13",
    "lodash": "4.18.1",
    "tinypool": "2.2.0",
    "valibot": "1.5.0",
    "ws": "8.22.0"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@shadcn/react@0.3.1": "patches/@shadcn%2Freact@0.3.1.patch"
  },
  "license": "MIT"
}
