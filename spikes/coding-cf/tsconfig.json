{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "bun", "node"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "runner/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}
