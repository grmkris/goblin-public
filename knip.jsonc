{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "binaries": "error",
    "catalog": "error",
    "catalogReferences": "error",
    "cycles": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "duplicates": "error",
    "enumMembers": "error",
    "exports": "error",
    "files": "error",
    "namespaceMembers": "error",
    "nsExports": "error",
    "nsTypes": "error",
    "optionalPeerDependencies": "error",
    "types": "error",
    "unlisted": "error",
    "unresolved": "error",
  },
  "treatConfigHintsAsErrors": false,
  "ignore": ["tools/oxlint/anti-slop/**"],
  // `cloudflare:workers` is a Workers runtime module (RpcTarget, WorkerEntrypoint), not a package.
  "ignoreDependencies": ["@effect/language-service", "cloudflare"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts!"],
    },
    "scripts/fixtures/mcp-app": {
      "entry": ["server.ts!", "client.mts!"],
      "project": ["**/*.ts", "**/*.mts"],
    },
    "spikes/coding": {
      "entry": ["scripts/server.ts!", "scripts/prepare.ts!"],
      "project": ["scripts/**/*.ts", "test/**/*.ts"],
    },
    "spikes/coding-cf": {
      "entry": ["src/index.ts!", "runner/server.ts!", "scripts/prepare.ts!", "scripts/stack.ts!"],
      "project": ["src/**/*.ts", "runner/**/*.ts", "scripts/**/*.ts"],
    },
    "tools": {
      "entry": ["*.ts!", "oxlint/*.ts!"],
      "ignoreDependencies": ["@effect/tsgo"],
    },
    "bench": {
      "entry": ["scripts/cli.ts!", "scripts/stack.ts!", "worker/worker.ts!"],
    },
    "apps/runtime": {
      "entry": ["test/provider-probe.ts!"],
    },
    "apps/web": {
      // Browser acceptance scripts boot the source fixtures through Vite, outside the app import graph.
      "entry": [
        "alchemy.run.ts!",
        "src/worker.ts!",
        "test/ui-*.ts!",
        "test/browser/*.tsx!",
        "test/browser/vite.config.ts!",
      ],
    },
    "packages/app": {
      // scripts/build.ts reads tw-animate-css's stylesheet from node_modules by path (its package exports CSS only).
      "ignoreDependencies": ["tw-animate-css"],
      // Bundled by scripts/build.ts into dist/toolchain.js and dist/runtime/; nothing imports them as modules.
      "entry": [
        "src/sdk.ts!",
        "src/release.ts!",
        "src/transpile.ts!",
        "src/style.ts!",
        "src/render.ts!",
        "src/ui/core.ts!",
        "src/ui/charts.ts!",
        "src/ui/maps.ts!",
        "src/ui/diagrams.ts!",
        "src/ui/icons.ts!",
      ],
    },
  },
  "ignoreExportsUsedInFile": true,
}
