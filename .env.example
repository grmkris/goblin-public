# Copy to .local/local.env and chmod 600. Local calls use CLIProxy; dev cloud calls use a dedicated LiteLLM key.
GOBLIN_APP_URL=http://localhost:18971
GOBLIN_BETTER_AUTH_SECRET=replace-with-a-long-local-development-secret
# Sign-up: open (anyone), invite (needs GOBLIN_SIGNUP_INVITE_CODE in the x-invite-code header) or closed. Local
# defaults to open; deployed stages default to closed.
GOBLIN_SIGNUP_MODE=open
GOBLIN_SIGNUP_INVITE_CODE=
# OTP mail is required. Local captures .eml files through Alchemy; deployed uses the onboarded sender.
GOBLIN_MAIL_SENDER=hello@goblin.test
# The existing account `bun run smoke:*` signs in as. Only the smoke reads these.
GOBLIN_OWNER_EMAIL=you@example.com
GOBLIN_SMOKE_SESSION_FILE=.local/local-session.json
GOBLIN_MODEL_BASE_URL=http://127.0.0.1:8317/v1
GOBLIN_MODEL_ID=gemini-3.8-flash
# GOBLIN_MODEL_KEY is inherited from CLIPROXY_API_KEY locally; set it only to override that key.
# Optional tokens per estimated Token Plan Credit (ADR 0026), for example
# {"models":{"glm-5.3":{"input":2500,"cached":25000,"output":400}}}. Unset, every model uses Alibaba's example rates.
# The daily allowance itself comes from the account: Pro (800 Credits a day) or its D1 operator override.
GOBLIN_MODEL_CREDIT_RATES=
GOBLIN_MCP_SERVERS=[]
# 32 random bytes, base64 (`openssl rand -base64 32`): encrypts outbound MCP OAuth tokens at rest.
GOBLIN_CREDENTIAL_KEY=replace-with-openssl-rand-base64-32

# Deployed stage configuration (.local/dev.env or .local/prod.env, mode 600).
# dev: GOBLIN_STAGE=dev, GOBLIN_APP_URL=https://dev.goblin.surf, GOBLIN_DOMAIN=dev.goblin.surf,
#      GOBLIN_SIGNUP_MODE=closed (or invite). Prod: values below. Separate secrets and model keys per stage.
# GOBLIN_STAGE=prod
# GOBLIN_APP_URL=https://goblin.surf
# GOBLIN_DOMAIN=goblin.surf
# GOBLIN_ZONE_ID=<Cloudflare zone ID for goblin.surf>
# GOBLIN_SIGNUP_MODE=invite
# GOBLIN_MAIL_SENDER=hello@goblin.surf (set only after Email Sending verification)
# GOBLIN_MODEL_BASE_URL=<Railway LiteLLM URL>/v1
# GOBLIN_MODEL_KEY=<dedicated model-limited budget-capped virtual key; never master>
# GOBLIN_BETTER_AUTH_SECRET=<openssl rand -hex 48>
# GOBLIN_CREDENTIAL_KEY=<openssl rand -base64 32; also derives user-bound hook tokens>
# GOBLIN_CONFIRM_PROD=1 must be explicitly set in the calling shell for every prod command.
# smoke:prod reads only /health and an anonymous auth probe unless an operator smoke account is configured.

# Dodo: test_mode on local/dev/test, live_mode on prod. API/product/webhook values are Worker secret bindings.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID=
