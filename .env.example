# Copy to .local/local.env and chmod 600. Local calls use CLIProxy; dev cloud calls use a dedicated LiteLLM key.
PURRABLE_APP_URL=http://localhost:18971
PURRABLE_BETTER_AUTH_SECRET=replace-with-a-long-local-development-secret
# Sign-up: open (anyone), invite (needs PURRABLE_SIGNUP_INVITE_CODE in the x-invite-code header) or closed. Local
# defaults to open; deployed stages default to closed.
PURRABLE_SIGNUP_MODE=open
PURRABLE_SIGNUP_INVITE_CODE=
# Cloudflare Email Sending address (an onboarded apex, e.g. purrable@mytab.lol). Set: sign-up needs email verification.
# Empty (the local default): no mail, no verification. A deployed stage refuses open sign-up without it.
PURRABLE_MAIL_SENDER=
# The existing account `bun run smoke:*` signs in as. Only the smoke reads these.
PURRABLE_OWNER_EMAIL=you@example.com
PURRABLE_OWNER_PASSWORD=
PURRABLE_MODEL_BASE_URL=http://127.0.0.1:8317/v1
PURRABLE_MODEL_ID=gemini-3.8-flash
# PURRABLE_MODEL_KEY is inherited from CLIPROXY_API_KEY locally; set it only to override that key.
# Local fixture budget only. Deployed accounts use Pro (2M/day) or their D1 operator override.
PURRABLE_MODEL_DAILY_TOKENS=300000
# Optional JSON price multipliers, for example {"premium-model":2}. Omitted models count at one.
PURRABLE_MODEL_TOKEN_WEIGHTS={}
PURRABLE_MCP_SERVERS=[]
# 32 random bytes, base64 (`openssl rand -base64 32`): encrypts outbound MCP OAuth tokens at rest.
PURRABLE_CREDENTIAL_KEY=replace-with-openssl-rand-base64-32

# Deployed stage configuration (.local/dev.env or .local/prod.env, mode 600).
# dev: PURRABLE_STAGE=dev, PURRABLE_APP_URL=https://dev.purrable.lol, PURRABLE_DOMAIN=dev.purrable.lol,
#      PURRABLE_SIGNUP_MODE=closed (or invite). Prod: values below. Separate secrets and model keys per stage.
# PURRABLE_STAGE=prod
# PURRABLE_APP_URL=https://purrable.lol
# PURRABLE_DOMAIN=purrable.lol
# PURRABLE_SIGNUP_MODE=open
# PURRABLE_MAIL_SENDER=hello@purrable.lol (set only after Email Sending verification)
# PURRABLE_MODEL_BASE_URL=<Railway LiteLLM URL>/v1
# PURRABLE_MODEL_KEY=<dedicated model-limited budget-capped virtual key; never master>
# PURRABLE_BETTER_AUTH_SECRET=<openssl rand -hex 48>
# PURRABLE_CREDENTIAL_KEY=<openssl rand -base64 32; also derives user-bound hook tokens>
# PURRABLE_CONFIRM_PROD=1 must be explicitly set in the calling shell for every prod command.
# smoke:prod reads only /health and an anonymous auth probe unless an operator smoke account is configured.

# Dodo: test_mode on local/dev/test, live_mode on prod. API/product/webhook values are Worker secret bindings.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_ID=
