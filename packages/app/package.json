{
  "name": "@goblin/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./toolchain": {
      "types": "./src/toolchain.d.ts",
      "default": "./dist/toolchain.js"
    },
    "./runtime/*": "./dist/runtime/*"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "effect:check": "bun ../../tools/effect-check.ts tsconfig.json tsconfig.ui.json",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@goblin/kit": "workspace:*",
    "@goblin/ui": "workspace:*",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "leaflet": "1.9.4",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "recharts": "3.10.1",
    "sucrase": "3.35.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260928.1",
    "@types/bun": "1.4.2",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
