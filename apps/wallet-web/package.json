{
  "name": "@goblin/wallet-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 18980 --strictPort",
    "build": "vite build && bun run build:views",
    "typecheck": "tsc -p tsconfig.json",
    "effect:check": "bun ../../tools/effect-check.ts tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "build:views": "vite build -c vite.views.config.ts --mode dashboard && vite build -c vite.views.config.ts --mode receipt"
  },
  "dependencies": {
    "@goblin/ui": "workspace:*",
    "@goblin/wallet": "workspace:*",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@privy-io/react-auth": "3.45.0",
    "@tanstack/react-query": "5.104.0",
    "effect": "4.0.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1"
  }
}
