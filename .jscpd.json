{
  "path": ["apps", "bench", "packages", "tools", "scripts"],
  "format": ["typescript", "tsx", "javascript"],
  "minTokens": 70,
  "minLines": 8,
  "threshold": 1.5,
  "reporters": ["console"],
  "gitignore": true,
  "absolute": false,
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.output/**",
    "**/.alchemy/**",
    "**/routeTree.gen.ts",
    "**/migrations/**",
    "**/__snapshots__/**",
    "tools/oxlint/anti-slop/**",
    "packages/ui/src/components/**",
    "**/test/**",
    "**/tests/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
